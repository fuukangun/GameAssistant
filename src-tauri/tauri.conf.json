{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "游戏助手",
  "version": "1.0.1",
  "identifier": "com.fuukangun.game-daily-planner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "游戏助手",
        "width": 1180,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "fuukangun",
    "homepage": "https://github.com/fuukangun/GameAssistant",
    "copyright": "版本 1.0.1 发布于2026-06-23\nDeveloper: fuukangun\nGitHub: https://github.com/fuukangun/GameAssistant",
    "resources": {
      "resources/Mac应用提示已损坏解决方案.md": "Mac应用提示已损坏解决方案.md"
    },
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
